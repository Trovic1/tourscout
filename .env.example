# Qloo hackathon key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Leave empty to run on built-in demo data.
QLOO_API_KEY=
# Optional; the hackathon base URL is the default.
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Free Gemini key from https://aistudio.google.com/apikey
# Leave empty to use the rule-based planner.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
